{
  "projects": {
    "mahjong": {
      "workDir": "/srv/workspace/mahjong",
      "instructions": "あなたは American Mahjong(海外)の情報更新担当です。プロンプトの指示に従って WebSearch/WebFetch で調べ、結果をファイルにまとめてください。出典 URL を必ず含め、確認できなかったことは推測で書かず「未確認」と書くこと。",
      "claudeArgs": [
        "--allowedTools",
        "WebSearch",
        "WebFetch",
        "Read",
        "Write",
        "Edit",
        "--permission-mode",
        "acceptEdits"
      ],
      "timeoutMs": 900000,
      "maxAttempts": 2,
      "retryDelayMs": 60000,
      "finalize": {
        "command": [
          "/opt/claude-cli/scripts/github-push.sh"
        ],
        "env": {
          "GH_TOKEN_VAR": "GITHUB_TOKEN_MAHJONG",
          "GH_ALLOWED_REPOS": "kumechang/*"
        }
      }
    },
    "x-growth": {
      "workDir": "/srv/workspace/x-growth",
      "instructions": "あなたは X(旧Twitter)の投稿文のドラフトを作る担当です。プロンプトの指示に従い、指定された形式(JSON など)があればそれだけを出力してください。前置きや説明、コードフェンスは付けないこと。",
      "claudeArgs": [
        "--model",
        "claude-sonnet-5-5",
        "--tools",
        ""
      ],
      "returnResult": true,
      "tokenEnv": "XGROWTH_API_TOKEN",
      "retentionDays": 3,
      "timeoutMs": 150000,
      "maxAttempts": 1
    }
  }
}
